04a\u308a\u3001\u8fb2\u696d\u4f53\u9a13\u3092\u901a\u3057\u3066\u8015\u4f5c\u653e\u68c4\u5730\u306e\u89e3\u6d88\u306b\u3088\u308b\u74b0\u5883\u4fdd\u5168\u3084\u95a2\u4fc2\u4eba\u53e3\u5275\u51fa\u306b\u3088\u308b\u5730\u57df\u6d3b\u6027\u306b\u3082\u5bc4\u4e0e\u3057\u3066\u3044\u307e\u3059\u3002<br \/>\n\u53c2\u52a0\u3059\u308b\u5c0f\u4e2d\u5b66\u751f\u306b\u3068\u3063\u3066\u306f\u8cb4\u91cd\u306a\u30ad\u30e3\u30ea\u30a2\u6559\u80b2\u306e\u5834\u306b\u3082\u306a\u3063\u3066\u3044\u307e\u3059\u3002<\/p>\n<p>9\u670823\u65e5(\u571f)\u3001\u4eca\u5e74\u5ea6\u306e\u9152\u7c73\u306e\u7a32\u5208\u308a\u304c\u884c\u308f\u308c\u307e\u3059\u3002\u5f53\u65e5\u306f\u9234\u4e0e\u682a\u5f0f\u4f1a\u793e\u306f\u3058\u3081\u9234\u4e0e\u30b0\u30eb\u30fc\u30d7\u5404\u793e\u306e\u793e\u54e1\u3084\u5bb6\u65cf\u3001\u83ca\u5ddd\u30b8\u30e5\u30cb\u30a2\u30d3\u30ec\u30c3\u30b8\u306e\u90e8\u54e1\u304c\u4e00\u7dd2\u306b\u3001\u305b\u3093\u304c\u307e\u3061\u68da\u7530\u5036\u697d\u90e8\u306e\u3054\u6307\u5c0e\u306e\u3082\u3068\u6d3b\u52d5\u3092\u884c\u3044\u307e\u3059\u3002<br \/>\n\u203b\u4ee4\u548c 4 \u5e74\u3001\u4e09\u8005\u3067\u5354\u5b9a\u66f8\u3092\u7d50\u3073\u3001\u672c\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u304c\u9759\u5ca1\u770c\u3088\u308a\u300c\u4e00\u793e\u4e00\u6751\u3057\u305a\u304a\u304b\u904b\u52d5\u300d\u3068\u3057\u3066\u8a8d<br \/>\n\u5b9a\u3055\u308c\u307e\u3057\u305f\u3002<\/p>\n<p>\u25a02023 \u5e74\u5ea6 SUZUYO \u3044\u3044\u306d\uff01\u30d7\u30ed\u30b8\u30a7\u30af\u30c8 \u9152\u7c73(\u4e94\u767e\u4e07\u77f3)\u306e\u7a32\u5208\u308a<br \/>\n\u30fb\u65e5\u6642\uff1a \u4ee4\u548c 5 \u5e74 9 \u6708 23 \u65e5\uff08\u571f\uff0910:00-15:00<br \/>\n\u30fb\u5834\u6240\uff1a \u4e0a\u5009\u6ca2\u516c\u4f1a\u5802\uff08\u83ca\u5ddd\u5e02\u5009\u6ca2 1121-1\uff09<br \/>\n\u30fb\u53c2\u52a0\u8005\uff1a\u9234\u4e0e\u682a\u5f0f\u4f1a\u793e\u3001\u30b0\u30ed\u30fc\u30ab\u30eb\u30c7\u30b6\u30a4\u30f3\u30b9\u30af\u30fc\u30eb\u682a\u5f0f\u4f1a\u793e\u3001NPO \u6cd5\u4eba\u305b\u3093\u304